diff --git a/uclibc_shim.c b/uclibc_shim.c
index 6ef9005..347f336 100644
--- a/uclibc_shim.c
+++ b/uclibc_shim.c
@@ -22,6 +22,14 @@
 #define DEBUG_PRINT(...) (void)0
 #endif
 
+/* On 32-bit uClibc built with _FILE_OFFSET_BITS=64, <stdio.h>/<fcntl.h> redirect
+ * fopen->fopen64, open->open64, fseeko->fseeko64 (asm __REDIRECT). That turns the
+ * *64 wrappers below into infinite self-recursion (compiles to `b .`). Bind to the
+ * base symbols explicitly to bypass the redirect; they exist in the old uClibc. */
+extern FILE *__shim_base_fopen(const char *, const char *) __asm__("fopen");
+extern int   __shim_base_open(const char *, int, ...) __asm__("open");
+extern int   __shim_base_fseeko(FILE *, off_t, int) __asm__("fseeko");
+
 void __pthread_register_cancel(void *buf) {
 	DEBUG_PRINT(stderr, "[WARNING] Called __pthread_register_cancel. This is a shim and does nothing.\n");
 }
@@ -68,7 +76,7 @@ int __fputc_unlocked(int c, FILE *stream) {
 
 FILE* fopen64(const char *path, const char *mode) {
 	DEBUG_PRINT(stderr, "[WARNING] Called fopen64. This is a shim and does nothing.\n");
-	return fopen(path, mode);
+	return __shim_base_fopen(path, mode);
 }
 
 int open64(const char *path, int flags, ...) {
@@ -84,15 +92,15 @@ int open64(const char *path, int flags, ...) {
 
 	DEBUG_PRINT(stderr, "[WARNING] Called open64. This is a shim and does nothing.\n");
 	if (flags & O_CREAT) {
-		return open(path, flags, mode);
+		return __shim_base_open(path, flags, mode);
 	} else {
-		return open(path, flags);
+		return __shim_base_open(path, flags);
 	}
 }
 
 int fseeko64(FILE *stream, off_t offset, int whence) {
 	DEBUG_PRINT(stderr, "[WARNING] Called fseeko64. This is a shim and does nothing.\n");
-	return fseeko(stream, offset, whence);
+	return __shim_base_fseeko(stream, offset, whence);
 }
 
 void* mmap64(void *start, size_t len, int prot, int flags, int fd, uint32_t off) {
